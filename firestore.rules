rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products Collection: Anyone can read products, but only admin (or none) can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Read-only for web client
    }

    // 2. Users Collection & Subcollections:
    // A user can read and write only their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Wishlist subcollection
      match /wishlist/{wishlistItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Closet subcollection
      match /closet/{closetItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Diary Entries subcollection
      match /diaryEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
