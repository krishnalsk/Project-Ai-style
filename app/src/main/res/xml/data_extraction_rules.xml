<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive auth data from cloud backup -->
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.js"/>
        <exclude domain="sharedpref" path="com.google.firebase.auth"/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude auth data from device transfer -->
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.js"/>
        <exclude domain="sharedpref" path="com.google.firebase.auth"/>
    </device-transfer>
</data-extraction-rules>
